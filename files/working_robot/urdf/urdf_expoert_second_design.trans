  <type>transmission_interface/SimpleTransmission</type>
  <joint name="elbow_arm_rotation">
    <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
  </joint>
  <actuator name="elbow_arm_rotation_actr">
    <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
    <mechanicalReduction>1</mechanicalReduction>
  </actuator>
</transmission>

<transmission name="gripper_holder_rotation_tran">
  <type>transmission_interface/SimpleTransmission</type>
  <joint name="gripper_holder_rotation">
    <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
  </joint>
  <actuator name="gripper_holder_rotation_actr">
    <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
    <mechanicalReduction>1</mechanicalReduction>
  </actuator>
</transmission>

<transmission name="end_factor_rotation_tran">
  <type>transmission_interface/SimpleTransmission</type>
  <joint name="end_factor_rotation">
    <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
