<?xml version="1.0" ?>
<robot name="urdf_expoert_second-design" xmlns:xacro="http://www.ros.org/wiki/xacro" >

<transmission name="bottom_holder_rotation_tran">
  <type>transmission_interface/SimpleTransmission</type>
  <joint name="bottom_holder_rotation">
    <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
  </joint>
  <actuator name="bottom_holder_rotation_actr">
    <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
    <mechanicalReduction>1</mechanicalReduction>
  </actuator>
</transmission>

