<joint name="gripper_holder_rotation" type="continuous">
  <origin xyz="0.003 0.0 0.1" rpy="0 0 0"/>
  <parent link="elbow_arm_1"/>
  <child link="gripper_holder_1"/>
  <axis xyz="-1.0 -0.0 -0.0"/>
</joint>

<joint name="end_factor_rotation" type="continuous">
  <origin xyz="-0.0231 0.0 0.1" rpy="0 0 0"/>
  <parent link="gripper_holder_1"/>
  <child link="robotic_arm_gripper_1"/>
  <axis xyz="-1.0 0.0 -0.0"/>
</joint>

