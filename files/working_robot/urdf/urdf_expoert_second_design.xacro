</joint>

<joint name="shoulder_arm_rotation" type="continuous">
  <origin xyz="0.005 0.0 0.0484" rpy="0 0 0"/>
  <parent link="bottom_holder_1"/>
  <child link="shoulder_arm_1"/>
  <axis xyz="1.0 0.0 0.0"/>
</joint>

<joint name="arm_holder_right_after_shoulder_rotation" type="continuous">
  <origin xyz="0.0022 0.0 0.1" rpy="0 0 0"/>
